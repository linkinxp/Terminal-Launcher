<?xml version="1.0" encoding="utf-8"?>
<!-- Layout, theme and every setting live in the DataStore files: Android's backup carries them to a new phone or a reinstall.
     Widgets that no longer exist on the new phone are dropped at startup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
